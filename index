<script>
  // Coloque aqui o número do WhatsApp da Maggon (só dígitos, com 55 + DDD). Vazio = botões levam ao Instagram.
  const WHATSAPP = "5527997269815";
  const MSG = "Olá! Vi o site da Maggon e me interessei pelos serviços. Gostaria de saber mais!";
  if (WHATSAPP) {
    document.querySelectorAll(".js-contact").forEach(a => {
      a.href = "https://wa.me/" + WHATSAPP + "?text=" + encodeURIComponent(MSG);
    });
  }
  // Modo claro (padrão) / noturno
  (function(){
    const root=document.documentElement, b=document.getElementById("modeToggle"), l=document.getElementById("modeLabel");
    function apply(m){
      if(m==="dark") root.setAttribute("data-mode","dark"); else root.removeAttribute("data-mode");
      const d=m==="dark"; b.setAttribute("aria-pressed",String(d)); l.textContent=d?"Modo claro":"Modo noturno";
    }
    let saved=null; try{saved=localStorage.getItem("maggon-mode")}catch(e){}
    apply(saved==="dark"?"dark":"light");
    b.addEventListener("click",function(){
      const m=root.getAttribute("data-mode")==="dark"?"light":"dark"; apply(m);
      try{localStorage.setItem("maggon-mode",m)}catch(e){}
    });
  })();

  // Revelar ao rolar + cabeçalho com sombra
  (function(){
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches || !("IntersectionObserver" in window)) return;
    document.documentElement.classList.add("motion");
    const groups=[".sec-head",".svc",".stage",".step",".faq details",".note",".cta",".band .wrap > *"];
    document.querySelectorAll(groups.join(",")).forEach(el=>{
      el.classList.add("reveal");
      const sibs=[...el.parentElement.children].filter(c=>c.matches(groups.join(",")));
      el.style.setProperty("--d",(Math.max(0,sibs.indexOf(el))*0.08).toFixed(2)+"s");
    });
    const io=new IntersectionObserver(es=>es.forEach(e=>{if(e.isIntersecting){e.target.classList.add("revealed");io.unobserve(e.target)}}),{threshold:.12,rootMargin:"0px 0px -6% 0px"});
    document.querySelectorAll(".reveal").forEach(el=>io.observe(el));
    const top=document.querySelector(".top");
    const onS=()=>top.classList.toggle("scrolled",window.scrollY>8);
    onS(); window.addEventListener("scroll",onS,{passive:true});
  })();
</script>

